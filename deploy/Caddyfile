{
	# Plain HTTP only for now. See README "Self-hosting" notes for enabling HTTPS.
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.open5e.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# The API (GET/HEAD only), same origin as the site.
	handle /api/2014/* {
		@write not method GET HEAD
		respond @write 405
		reverse_proxy api:3000 {
			# The API redirects to https unless it sees a secure request; TLS is not terminated here yet.
			header_up X-Forwarded-Proto https
			header_down -Strict-Transport-Security
		}
	}

	# Static site: whitelist only the served files (the directory also holds .git, .env, compose files).
	handle {
		@site path / /index.html /config.js /fonts/*
		handle @site {
			root * /srv/site
			@nocache path / /index.html /config.js
			header @nocache Cache-Control "no-cache"
			header /fonts/* Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		respond 404
	}
}
